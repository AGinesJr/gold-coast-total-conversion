{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gold-coast.invalid/schemas/agent-task.schema.json",
  "title": "Gold Coast Agent Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent",
    "objective",
    "context",
    "allowed_paths",
    "forbidden_actions",
    "deliverables",
    "acceptance",
    "risk_tier",
    "budget",
    "reviewer",
    "rollback"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^GC-[A-Z0-9]+-[0-9]{4}$"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "risk_tier": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_model_calls",
        "max_retries"
      ],
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "max_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "in_progress",
        "blocked",
        "complete"
      ],
      "default": "draft"
    }
  }
}
